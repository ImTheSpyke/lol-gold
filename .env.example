# ── Application ───────────────────────────────────────────────────────────────
# Dashboard port (host port when running via docker compose)
PORT=3000
# Directory holding config.json (defaults to the working directory)
# CONFIG_DIR=./data

# ── MariaDB connection (remote or local) ──────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=lolgold
DB_PASSWORD=lolgold
DB_NAME=btg_temp

# ── Optional: only needed if you use the local MariaDB container ──────────────
# (docker compose --profile db up)
DB_ROOT_PASSWORD=rootpassword
