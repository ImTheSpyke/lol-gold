# ── Application ───────────────────────────────────────────────────────────────
# Dashboard port (host port when running via docker compose)
PORT=3000
# Directory holding config.json (defaults to the working directory)
# CONFIG_DIR=./data

# Image tag used by docker compose (default: latest)
# IMAGE_TAG=latest

# ── MariaDB connection ────────────────────────────────────────────────────────
# DB_HOST is deliberately NOT set so both setups work out of the box:
#   - docker compose (app + bundled MariaDB) → defaults to "mariadb"
#   - npm run dev on Windows                 → defaults to 127.0.0.1
# Only set it to use a remote server. NEVER set it to 127.0.0.1 for docker
# compose: inside the container that is the container itself, not the database.
# DB_HOST=your-db-hostname
DB_PORT=3306
DB_USER=lolgold
DB_PASSWORD=lolgold
DB_NAME=btg_temp

# ── Bundled MariaDB container only ────────────────────────────────────────────
# Used by `docker compose --profile db` / `npm run db:up`
DB_ROOT_PASSWORD=rootpassword
