# ── Application ───────────────────────────────────────────────────────────────
# Dashboard port (host port when running via docker compose)
PORT=3000
# Directory holding config.json (defaults to the working directory)
# CONFIG_DIR=./data

# Image tag used by docker compose (default: latest)
# IMAGE_TAG=latest

# ── MariaDB connection (remote or local) ──────────────────────────────────────
# App on the host + DB via `npm run db:up`  → 127.0.0.1
# App in docker compose with the db profile → mariadb (or leave unset)
# Remote server                             → its hostname
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=lolgold
DB_PASSWORD=lolgold
DB_NAME=btg_temp

# ── Optional: only needed if you use the local MariaDB container ──────────────
# (docker compose --profile db up)
DB_ROOT_PASSWORD=rootpassword
