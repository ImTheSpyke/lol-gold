{
  "name": "lol-graph",
  "version": "26.0.2",
  "description": "Real-time League of Legends team gold tracker: screen OCR, SQLite storage and a live graph dashboard.",
  "license": "MIT",
  "private": true,
  "main": "dist/index.js",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "node node_modules/tsc7/bin/tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "node node_modules/tsc7/bin/tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@napi-rs/canvas": "^1.0.11",
    "chart.js": "^4.5.1",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "node-screenshots": "^0.2.8",
    "onnxruntime-node": "^1.30.0",
    "ppu-paddle-ocr": "^6.6.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "ts-node-dev": "^2.0.0",
    "tsc7": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ]
  }
}
